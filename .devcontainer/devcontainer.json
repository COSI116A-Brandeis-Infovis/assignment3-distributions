{
    "image": "mcr.microsoft.com/devcontainers/universal",
    "hostRequirements": {
        "cpus": 2
    },
    "waitFor": "updateContentCommand",
    "updateContentCommand": "python3 -m pip install -r requirements.txt",
    "postCreateCommand": "",
    "customizations": {
        "codespaces": {
            "openFiles": [
                "README.md",
                "vg_sales_exploration.ipynb"
            ]
        },
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-python.python"
            ]
        }
    }
}
